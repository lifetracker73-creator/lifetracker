# ALLOWLIST: git ignores EVERYTHING by default.
# Only the app code, icons, fonts and docs listed in step 2 can ever be uploaded.
# Anything else saved in this folder (backups, exports, screenshots, PRIVATE.md...)
# is ignored automatically. Step 3 blocks risky files again, just to be extra safe.

# 1) Ignore everything
*
# Let git look inside folders (files inside stay ignored unless allowed below)
!*/

# 2) Allowed files
!/.gitignore
!/CLAUDE.md
!/SPEC.md
!/PROGRESS.md
!/index.html
!/manifest.webmanifest
!/sw.js
!/core/*.js
!/core/*.css
!/core/vendor/*.js
!/core/fonts/*.ttf
!/core/fonts/OFL.txt
!/icons/*.png
!/google-apps-script/Code.gs
!/google-apps-script/appsscript.json
!/water/*.js
!/water/*.css
!/sleep/*.js
!/sleep/*.css
!/weight/*.js
!/weight/*.css
!/food/*.js
!/food/*.css
!/money/*.js
!/money/*.css
!/tasks/*.js
!/tasks/*.css
!/reading/*.js
!/reading/*.css
!/medical/*.js
!/medical/*.css
!/gym/*.js
!/gym/*.css
!/refills/*.js
!/refills/*.css

# 3) Never upload these, even if they match an allowed rule above
PRIVATE.md
PRIVATE*
*private*
.claude/
settings.local.json
.env
.env.*
*.key
*.pem
*backup*
!/core/backup.js
backups/
exports/
*export*
*.json
!/google-apps-script/appsscript.json
*.xlsx
*.xls
*.csv
*.ics
*.pdf
*creenshot*
Screen Shot*
*.jpg
*.jpeg
*.heic
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
~$*
